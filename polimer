<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cuộc Đua Giải Mật Mã - Realtime</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <script type="module">
        import { initializeApp } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-app.js";
        import { getAuth, signInAnonymously, signInWithCustomToken, onAuthStateChanged } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-auth.js";
        import { getFirestore, doc, getDoc, setDoc, updateDoc, onSnapshot } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-firestore.js";

        // Firebase Configuration injected via environment
        const appId = typeof __app_id !== 'undefined' ? __app_id : "cuoc-dua-giai-mat-ma"; 
        const firebaseConfig = typeof __firebase_config !== 'undefined' ? JSON.parse(__firebase_config) : {};
        
        let app, db, auth;
        if (Object.keys(firebaseConfig).length > 0) {
            app = initializeApp(firebaseConfig);
            db = getFirestore(app);
            auth = getAuth(app);
        }

        const TOTAL_CHALLENGES = 2;
        let globalGameState = null;
        let currentUser = null;
        let currentRole = 'teacher'; 
        let studentTeam = null; 
        let currentAttempt = { level: null };
        let renderedNumTeams = 0; // Tránh render lại DOM nếu số lượng không đổi

        // Bảng màu cho các đội (lặp lại nếu số đội lớn hơn 6)
        const THEMES = [
            { bg: 'bg-[#f15b5b]', border: 'border-[#f15b5b]', text: 'text-[#f15b5b]', light: 'bg-[#ffeded]', icon: 'fa-fire', iconColor: 'text-yellow-300' },
            { bg: 'bg-[#f29924]', border: 'border-[#f29924]', text: 'text-[#f29924]', light: 'bg-[#fff4e6]', icon: 'fa-bolt', iconColor: 'text-yellow-100' },
            { bg: 'bg-[#a2cc14]', border: 'border-[#a2cc14]', text: 'text-[#a2cc14]', light: 'bg-[#f5fae6]', icon: 'fa-sun', iconColor: 'text-yellow-200' },
            { bg: 'bg-[#3b82f6]', border: 'border-[#3b82f6]', text: 'text-[#3b82f6]', light: 'bg-[#eff6ff]', icon: 'fa-water', iconColor: 'text-cyan-200' },
            { bg: 'bg-[#a855f7]', border: 'border-[#a855f7]', text: 'text-[#a855f7]', light: 'bg-[#faf5ff]', icon: 'fa-star', iconColor: 'text-pink-200' },
            { bg: 'bg-[#ec4899]', border: 'border-[#ec4899]', text: 'text-[#ec4899]', light: 'bg-[#fdf2f8]', icon: 'fa-heart', iconColor: 'text-rose-200' }
        ];

        const defaultState = {
            numTeams: 3,
            teamsConfig: {
                1: { name: 'DẺO PLASTIC', passwords: ['KHÁI NIỆM', 'PHÂN BIỆT'], keywords: ['RÁC THẢI', 'NHỰA'] },
                2: { name: 'COMPOSITE HỢP LỰC', passwords: ['KHÁI NIỆM', 'PHÂN BIỆT'], keywords: ['TÁI', 'CHẾ'] },
                3: { name: 'SILK BỀN BỈ', passwords: ['KHÁI NIỆM', 'PHÂN BIỆT'], keywords: ['NHỰA', 'SINH HỌC'] }
            },
            teamsProgress: {
                1: 0,
                2: 0,
                3: 0
            },
            teamsLastUpdated: {
                1: 0,
                2: 0,
                3: 0
            }
        };

        // --- Core UI Functions ---
        function showToast(message, type = 'error') {
            const toast = document.getElementById('toast');
            toast.textContent = message;
            toast.className = `fixed top-4 left-1/2 transform -translate-x-1/2 px-6 py-3 rounded-full shadow-lg transition-opacity duration-300 pointer-events-none z-[100] font-semibold text-white ${type === 'error' ? 'bg-red-500' : 'bg-green-500'}`;
            toast.style.opacity = '1';
            setTimeout(() => { toast.style.opacity = '0'; }, 3000);
        }

        // --- Audio & TTS Effects ---
        let audioCtx;
        function initAudio() {
            if (!audioCtx) {
                audioCtx = new (window.AudioContext || window.webkitAudioContext)();
            }
            if (audioCtx.state === 'suspended') {
                audioCtx.resume();
            }
        }

        function playSound(type) {
            initAudio();
            const osc = audioCtx.createOscillator();
            const gainNode = audioCtx.createGain();
            osc.connect(gainNode);
            gainNode.connect(audioCtx.destination);
            
            if (type === 'correct') {
                osc.type = 'triangle';
                // Tạo hợp âm chiến thắng
                osc.frequency.setValueAtTime(523.25, audioCtx.currentTime); // C5
                osc.frequency.setValueAtTime(659.25, audioCtx.currentTime + 0.1); // E5
                osc.frequency.setValueAtTime(783.99, audioCtx.currentTime + 0.2); // G5
                osc.frequency.setValueAtTime(1046.50, audioCtx.currentTime + 0.3); // C6
                gainNode.gain.setValueAtTime(0.15, audioCtx.currentTime);
                gainNode.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + 0.5);
                osc.start();
                osc.stop(audioCtx.currentTime + 0.5);
            } else {
                osc.type = 'sawtooth';
                // Tạo âm thanh sai (buzz)
                osc.frequency.setValueAtTime(200, audioCtx.currentTime); 
                osc.frequency.linearRampToValueAtTime(100, audioCtx.currentTime + 0.3);
                gainNode.gain.setValueAtTime(0.15, audioCtx.currentTime);
                gainNode.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + 0.3);
                osc.start();
                osc.stop(audioCtx.currentTime + 0.3);
            }
        }

        function speak(text) {
            if ('speechSynthesis' in window) {
                window.speechSynthesis.cancel(); // Dừng câu trước đó nếu đang đọc
                const msg = new SpeechSynthesisUtterance(text);
                msg.lang = 'vi-VN'; // Giọng tiếng Việt
                msg.rate = 1.1;
                window.speechSynthesis.speak(msg);
            }
        }

        function switchTab(role) {
            currentRole = role;
            document.querySelectorAll('.view-section').forEach(el => el.classList.add('hidden'));
            document.getElementById(`view-${role}`).classList.remove('hidden');
            
            // Tab styling
            document.querySelectorAll('.nav-tab').forEach(el => {
                el.classList.remove('bg-blue-600', 'text-white', 'shadow-md');
                el.classList.add('text-gray-400', 'hover:bg-gray-800');
            });
            const activeTab = document.getElementById(`tab-${role}`);
            activeTab.classList.remove('text-gray-400', 'hover:bg-gray-800');
            activeTab.classList.add('bg-blue-600', 'text-white', 'shadow-md');

            if (role === 'admin' && globalGameState) {
                document.getElementById('admin-num-teams').value = globalGameState.numTeams;
                buildAdminStructure(globalGameState.numTeams);
                populateAdminForm();
            }
            if (role === 'student' && !studentTeam) {
                document.getElementById('student-select-team').classList.remove('hidden');
                document.getElementById('student-workspace').classList.add('hidden');
            }
            
            updateUI(); // Đảm bảo đồng bộ ngay lập tức khi chuyển qua lại giữa các tab
        }
        window.switchTab = switchTab;

        function checkAndRebuildDOM() {
            if (!globalGameState) return;
            if (renderedNumTeams !== globalGameState.numTeams) {
                renderedNumTeams = globalGameState.numTeams;
                buildTeacherStructure(renderedNumTeams);
                buildStudentSelectionStructure(renderedNumTeams);
            }
        }

        function buildTeacherStructure(num) {
            const container = document.getElementById('teacher-teams');
            container.innerHTML = '';
            // Sử dụng CSS Grid nội tuyến để đảm bảo chia đều các cột trên 1 hàng ngang
            container.style.display = 'grid';
            container.style.gridTemplateColumns = `repeat(${num}, minmax(0, 1fr))`;
            container.style.gap = '1rem';
            container.style.width = '100%';

            for(let i=1; i<=num; i++) {
                const t = THEMES[(i-1) % THEMES.length];
                container.innerHTML += `
                    <div class="bg-white rounded-2xl border-[4px] ${t.border} p-3 shadow-xl flex flex-col h-full">
                        <div class="${t.bg} rounded-xl p-3 text-white flex flex-col items-center shadow-inner relative">
                            <div class="absolute right-2 top-2 font-bold text-[10px] tracking-wider animate-pulse"><i class="fa-solid fa-circle text-green-300 text-[8px] align-middle mr-1"></i>LIVE</div>
                            <h2 id="teacher-team-name-${i}" class="text-xl font-bold mb-1 flex items-center gap-2 text-center uppercase"><i class="fa-solid ${t.icon} ${t.iconColor}"></i> <span id="t-name-text-${i}" class="whitespace-nowrap">NHÓM ${i}</span></h2>
                            <p id="teacher-team-${i}-progress" class="text-xs font-medium bg-black/20 px-2 py-1 rounded-full mt-1">0/${TOTAL_CHALLENGES} thử thách</p>
                        </div>
                        <div class="flex flex-row justify-center gap-4 mt-8 px-4 w-full">
                            <div id="teacher-t${i}-l1" class="flex-1 h-32 md:h-40 rounded-2xl ${t.light} flex flex-col items-center justify-center shadow-inner transition-all duration-500"><i class="fa-solid fa-lock text-5xl md:text-6xl text-gray-400"></i><span class="font-bold opacity-70 mt-4 text-lg md:text-xl">Thử thách 1</span></div>
                            <div id="teacher-t${i}-l2" class="flex-1 h-32 md:h-40 rounded-2xl ${t.light} flex flex-col items-center justify-center shadow-inner transition-all duration-500"><i class="fa-solid fa-lock text-5xl md:text-6xl text-gray-400"></i><span class="font-bold opacity-70 mt-4 text-lg md:text-xl">Thử thách 2</span></div>
                        </div>
                        <div class="flex flex-row justify-center gap-2 mt-auto mb-2 px-2 pt-6 w-full flex-nowrap">
                            <div id="teacher-t${i}-f1" class="flex-1 px-3 min-h-[3.5rem] rounded-lg border-2 ${t.border} flex items-center justify-center text-lg font-bold ${t.text} bg-gray-50 transition-colors whitespace-nowrap overflow-hidden text-ellipsis">?</div>
                            <div id="teacher-t${i}-f2" class="flex-1 px-3 min-h-[3.5rem] rounded-lg border-2 ${t.border} flex items-center justify-center text-lg font-bold ${t.text} bg-gray-50 transition-colors whitespace-nowrap overflow-hidden text-ellipsis">?</div>
                        </div>
                    </div>
                `;
            }
        }

        function buildStudentSelectionStructure(num) {
            const container = document.getElementById('student-team-buttons');
            container.innerHTML = '';
            container.className = 'grid gap-4 md:gap-6 w-full';
            container.style.gridTemplateColumns = `repeat(${num}, minmax(0, 1fr))`;
            
            for(let i=1; i<=num; i++) {
                const t = THEMES[(i-1) % THEMES.length];
                const teamName = globalGameState.teamsConfig[i]?.name || `NHÓM ${i}`;
                container.innerHTML += `
                    <button onclick="joinTeam(${i})" class="w-full ${t.bg} hover:brightness-110 text-white p-4 md:p-6 rounded-2xl font-bold text-lg md:text-xl shadow-xl transition-transform hover:-translate-y-2 border-b-4 border-black/20 flex flex-col items-center justify-center whitespace-nowrap">
                        <i class="fa-solid ${t.icon} block text-3xl md:text-4xl mb-3 ${t.iconColor}"></i> <span id="student-select-name-${i}" class="uppercase">${teamName}</span>
                    </button>
                `;
            }
        }

        function buildAdminStructure(num) {
            const container = document.getElementById('admin-teams-container');
            container.innerHTML = '';
            for(let i=1; i<=num; i++) {
                container.innerHTML += `
                    <div class="bg-[#151936] p-6 rounded-2xl border border-gray-700/50">
                        <h3 class="text-lg font-bold text-orange-400 mb-4 border-l-4 border-orange-400 pl-3">Cấu hình Đội ${i}</h3>
                        <div class="space-y-4">
                            <div>
                                <label class="block text-sm font-semibold text-gray-300 mb-1">Tên đội:</label>
                                <input type="text" id="cfg-name-${i}" placeholder="VD: Nhóm 1 - 5A4" class="w-full bg-[#0f1229] border border-gray-600 rounded-xl px-4 py-2 text-white focus:outline-none focus:border-blue-500 transition-colors">
                            </div>
                            <div class="grid grid-cols-2 gap-4">
                                <div>
                                    <label class="block text-xs font-semibold text-gray-400 mb-1">Mật mã Thử thách 1:</label>
                                    <input type="text" id="cfg-pass-1-${i}" class="w-full bg-[#0f1229] border border-gray-600 rounded-xl px-3 py-2 text-white font-mono focus:outline-none focus:border-blue-500">
                                </div>
                                <div>
                                    <label class="block text-xs font-semibold text-gray-400 mb-1">Từ khóa Thử thách 1:</label>
                                    <input type="text" id="cfg-key-1-${i}" class="w-full bg-[#0f1229] border border-gray-600 rounded-xl px-3 py-2 text-white uppercase text-center focus:outline-none focus:border-blue-500">
                                </div>
                            </div>
                            <div class="grid grid-cols-2 gap-4">
                                <div>
                                    <label class="block text-xs font-semibold text-gray-400 mb-1">Mật mã Thử thách 2:</label>
                                    <input type="text" id="cfg-pass-2-${i}" class="w-full bg-[#0f1229] border border-gray-600 rounded-xl px-3 py-2 text-white font-mono focus:outline-none focus:border-blue-500">
                                </div>
                                <div>
                                    <label class="block text-xs font-semibold text-gray-400 mb-1">Từ khóa Thử thách 2:</label>
                                    <input type="text" id="cfg-key-2-${i}" class="w-full bg-[#0f1229] border border-gray-600 rounded-xl px-3 py-2 text-white uppercase text-center focus:outline-none focus:border-blue-500">
                                </div>
                            </div>
                        </div>
                    </div>
                `;
            }
        }

        window.changeAdminNumTeams = function() {
            const num = parseInt(document.getElementById('admin-num-teams').value);
            if(num >= 1 && num <= 10) buildAdminStructure(num);
        }

        function updateUI() {
            if (!globalGameState) return;
            checkAndRebuildDOM();

            // 1. Update Teacher View
            for(let team = 1; team <= globalGameState.numTeams; team++) {
                const config = globalGameState.teamsConfig[team];
                const progress = globalGameState.teamsProgress[team] || 0;
                
                const nameTextEl = document.getElementById(`t-name-text-${team}`);
                if(nameTextEl && config) nameTextEl.textContent = config.name;
                
                const progEl = document.getElementById(`teacher-team-${team}-progress`);
                if(progEl) progEl.textContent = `${progress}/${TOTAL_CHALLENGES} thử thách`;
                
                for(let level = 1; level <= TOTAL_CHALLENGES; level++) {
                    const btn = document.getElementById(`teacher-t${team}-l${level}`);
                    const frag = document.getElementById(`teacher-t${team}-f${level}`);
                    if(!btn || !frag) continue;
                    
                    if (progress >= level) {
                        btn.classList.add('unlocked-card', 'bg-white');
                        btn.innerHTML = `<i class="fa-solid fa-lock-open text-5xl md:text-6xl text-orange-400"></i><span class="font-bold text-gray-800 mt-4 text-lg md:text-xl">Thử thách ${level}</span>`;
                        frag.textContent = config.keywords[level-1] || '';
                        frag.classList.add('bg-white');
                    } else {
                        btn.classList.remove('unlocked-card', 'bg-white');
                        btn.innerHTML = `<i class="fa-solid fa-lock text-5xl md:text-6xl text-gray-400 opacity-80"></i><span class="font-bold opacity-70 mt-4 text-lg md:text-xl">Thử thách ${level}</span>`;
                        frag.textContent = '?';
                        frag.classList.remove('bg-white');
                    }
                }
            }

            // 2. Update Student Workspace
            // Nếu admin giảm số đội và học sinh đang ở đội không còn tồn tại -> Thoát ra màn hình chọn đội
            if (studentTeam && studentTeam > globalGameState.numTeams) {
                leaveTeam();
            }

            if (!studentTeam) {
                // Cập nhật tên trên nút chọn đội ngoài màn hình chờ
                for(let team = 1; team <= globalGameState.numTeams; team++) {
                   const selName = document.getElementById(`student-select-name-${team}`);
                   if(selName && globalGameState.teamsConfig[team]) {
                       selName.textContent = globalGameState.teamsConfig[team].name;
                   }
                }
            } else {
                // Cập nhật thông tin trong không gian làm việc của đội
                const progress = globalGameState.teamsProgress[studentTeam] || 0;
                const config = globalGameState.teamsConfig[studentTeam];
                
                const progressText = document.getElementById('student-progress-text');
                const titleText = document.getElementById('student-team-title');
                
                if (progressText) progressText.textContent = `${progress}/${TOTAL_CHALLENGES} thử thách`;
                if (titleText) titleText.textContent = config?.name || `NHÓM ${studentTeam}`;

                for(let level = 1; level <= TOTAL_CHALLENGES; level++) {
                    const btn = document.getElementById(`student-l${level}`);
                    const frag = document.getElementById(`student-f${level}`);
                    if(!btn || !frag) continue;
                    
                    if (progress >= level) {
                        btn.classList.add('unlocked-card', 'bg-white');
                        btn.innerHTML = `<i class="fa-solid fa-lock-open text-5xl md:text-6xl text-orange-400"></i><span class="font-bold text-gray-800 mt-4 text-xl">Đã mở</span>`;
                        frag.textContent = config?.keywords[level-1] || '';
                        frag.classList.add('bg-white');
                    } else {
                        btn.classList.remove('unlocked-card', 'bg-white');
                        btn.innerHTML = `<i class="fa-solid fa-lock text-5xl md:text-6xl text-gray-400"></i><span class="font-bold opacity-70 mt-4 text-xl">Thử thách ${level}</span>`;
                        frag.textContent = '?';
                        frag.classList.remove('bg-white');
                    }
                }
            }
        }

        // --- Firebase & Game Logic ---
        function initGame() {
            if (!auth) {
                showToast("Môi trường thiếu cấu hình Firebase.", "error");
                return;
            }

            // Lắng nghe trạng thái đăng nhập
            onAuthStateChanged(auth, (user) => {
                if (user) {
                    currentUser = user;
                    document.getElementById('loading-overlay').classList.add('hidden');
                    setupFirestore();
                } else {
                    currentUser = null;
                    if (typeof __initial_auth_token !== 'undefined') {
                        signInWithCustomToken(auth, __initial_auth_token).catch(console.error);
                    } else {
                        signInAnonymously(auth).catch(console.error);
                    }
                }
            });
        }

        async function setupFirestore() {
            try {
                // STRICT PATH: /artifacts/{appId}/public/data/{collectionName}
                const docRef = doc(db, 'artifacts', appId, 'public', 'data', 'cuocdua', 'state');
                const docSnap = await getDoc(docRef);

                if (!docSnap.exists()) {
                    await setDoc(docRef, defaultState);
                }

                // Listen to Realtime changes
                onSnapshot(docRef, (snapshot) => {
                    if (snapshot.exists()) {
                        globalGameState = snapshot.data();
                        document.getElementById('loading-overlay').classList.add('hidden');
                        updateUI();
                    }
                }, (error) => {
                    console.error("Lỗi đồng bộ:", error);
                    showToast("Mất kết nối dữ liệu!", "error");
                });

            } catch (error) {
                console.error("Lỗi khởi tạo:", error);
                showToast("Lỗi kết nối CSDL (Kiểm tra lại quyền Rules).", "error");
                document.getElementById('loading-overlay').classList.add('hidden');
            }
        }

        // --- Student Actions ---
        window.joinTeam = function(team) {
            studentTeam = team;
            document.getElementById('student-select-team').classList.add('hidden');
            const ws = document.getElementById('student-workspace');
            ws.classList.remove('hidden');
            
            const theme = THEMES[(team-1) % THEMES.length];
            const config = globalGameState.teamsConfig[team];
            
            document.getElementById('student-team-title').innerHTML = config?.name || `NHÓM ${team}`;
            const header = document.getElementById('student-team-header');
            header.className = `${theme.bg} rounded-[24px] p-6 text-white flex flex-col items-center justify-center relative shadow-md uppercase`;
            
            const card = document.getElementById('student-team-card');
            card.className = `bg-white rounded-[32px] border-[6px] ${theme.border} p-3 shadow-2xl flex flex-col relative w-full max-w-2xl mx-auto min-h-[500px] mt-10`;

            document.querySelectorAll('.student-frag').forEach(el => {
                el.className = `student-frag flex-1 px-4 min-h-[5rem] rounded-2xl border-[3px] ${theme.border} flex items-center justify-center text-2xl md:text-3xl font-bold ${theme.text} bg-gray-50/50 shadow-sm transition-colors uppercase whitespace-nowrap`;
            });

            updateUI();
        };

        window.leaveTeam = function() {
            studentTeam = null;
            document.getElementById('student-workspace').classList.add('hidden');
            document.getElementById('student-select-team').classList.remove('hidden');
        };

        window.openChallenge = function(level) {
            if (!globalGameState || !studentTeam) return;
            const currentProgress = globalGameState.teamsProgress[studentTeam] || 0;

            if (level <= currentProgress) {
                showToast("Thử thách này đã được giải!", "success");
                return;
            }
            if (level > currentProgress + 1) {
                showToast(`Bạn phải giải mã Thử thách ${level-1} trước!`, "error");
                return;
            }

            currentAttempt.level = level;
            document.getElementById('modalTitle').textContent = `MẬT MÃ THỬ THÁCH ${level}`;
            document.getElementById('passwordInput').value = '';
            
            const modal = document.getElementById('passwordModal');
            const content = document.getElementById('modalContent');
            modal.classList.remove('hidden');
            setTimeout(() => {
                content.classList.remove('scale-95', 'opacity-0');
                document.getElementById('passwordInput').focus();
            }, 10);
        };

        window.closeModal = function() {
            const modal = document.getElementById('passwordModal');
            const content = document.getElementById('modalContent');
            content.classList.add('scale-95', 'opacity-0');
            setTimeout(() => { modal.classList.add('hidden'); }, 200);
        };

        window.submitPassword = async function() {
            const input = document.getElementById('passwordInput').value.trim().toLowerCase();
            const level = currentAttempt.level;
            const config = globalGameState.teamsConfig[studentTeam];
            const correctPass = config ? config.passwords[level-1].toLowerCase() : '';

            if (input === correctPass) {
                try {
                    playSound('correct');
                    speak("Chính xác! Đã mở khóa thành công.");
                    const docRef = doc(db, 'artifacts', appId, 'public', 'data', 'cuocdua', 'state');
                    await updateDoc(docRef, {
                        [`teamsProgress.${studentTeam}`]: level,
                        [`teamsLastUpdated.${studentTeam}`]: Date.now()
                    });
                    closeModal();
                    showToast("🎉 CHÍNH XÁC! Đã mở khóa.", "success");
                } catch (e) {
                    showToast("Lỗi đồng bộ. Thử lại sau.", "error");
                }
            } else {
                playSound('incorrect');
                speak("Sai mật mã rồi, hãy thử lại!");
                const content = document.getElementById('modalContent');
                content.classList.add('shake');
                document.getElementById('passwordInput').value = '';
                setTimeout(() => content.classList.remove('shake'), 500);
                showToast("Sai mật mã rồi!", "error");
            }
        };

        // --- Admin Actions ---
        function populateAdminForm() {
            const num = parseInt(document.getElementById('admin-num-teams').value) || globalGameState.numTeams;
            for(let i=1; i<=num; i++) {
                const cfg = globalGameState.teamsConfig[i];
                if(cfg) {
                    const elName = document.getElementById(`cfg-name-${i}`);
                    if(elName) elName.value = cfg.name || '';
                    const elP1 = document.getElementById(`cfg-pass-1-${i}`);
                    if(elP1) elP1.value = cfg.passwords[0] || '';
                    const elK1 = document.getElementById(`cfg-key-1-${i}`);
                    if(elK1) elK1.value = cfg.keywords[0] || '';
                    const elP2 = document.getElementById(`cfg-pass-2-${i}`);
                    if(elP2) elP2.value = cfg.passwords[1] || '';
                    const elK2 = document.getElementById(`cfg-key-2-${i}`);
                    if(elK2) elK2.value = cfg.keywords[1] || '';
                }
            }
        }

        window.saveConfig = async function() {
            const numTeams = parseInt(document.getElementById('admin-num-teams').value) || 3;
            const newConfig = {};
            const newProgress = {};
            const newLastUpdated = {};
            
            for(let i=1; i<=numTeams; i++) {
                newConfig[i] = {
                    name: document.getElementById(`cfg-name-${i}`)?.value.trim() || `NHÓM ${i}`,
                    passwords: [
                        document.getElementById(`cfg-pass-1-${i}`)?.value.trim() || 'KHÁI NIỆM',
                        document.getElementById(`cfg-pass-2-${i}`)?.value.trim() || 'PHÂN BIỆT'
                    ],
                    keywords: [
                        document.getElementById(`cfg-key-1-${i}`)?.value.trim() || 'A',
                        document.getElementById(`cfg-key-2-${i}`)?.value.trim() || 'B'
                    ]
                };
                newProgress[i] = globalGameState?.teamsProgress?.[i] || 0;
                newLastUpdated[i] = globalGameState?.teamsLastUpdated?.[i] || 0;
            }

            try {
                const docRef = doc(db, 'artifacts', appId, 'public', 'data', 'cuocdua', 'state');
                await updateDoc(docRef, { 
                    numTeams: numTeams,
                    teamsConfig: newConfig,
                    teamsProgress: newProgress,
                    teamsLastUpdated: newLastUpdated
                });
                showToast("Đã lưu cấu hình trò chơi!", "success");
            } catch (e) {
                console.error(e);
                showToast("Lỗi khi lưu cấu hình.", "error");
            }
        };

        window.resetGameProgress = async function() {
            try {
                const docRef = doc(db, 'artifacts', appId, 'public', 'data', 'cuocdua', 'state');
                const numTeams = globalGameState.numTeams || 3;
                const resetData = {};
                for(let i=1; i<=numTeams; i++) {
                    resetData[`teamsProgress.${i}`] = 0;
                    resetData[`teamsLastUpdated.${i}`] = 0;
                }
                
                await updateDoc(docRef, resetData);
                showToast("Đã đặt lại toàn bộ tiến độ!", "success");
            } catch (e) {
                showToast("Lỗi khi reset.", "error");
            }
        };
        
        window.showLeaderboard = function() {
            if (!globalGameState) return;
            const teamsList = [];
            for (let i = 1; i <= globalGameState.numTeams; i++) {
                const config = globalGameState.teamsConfig[i];
                if (!config) continue;
                
                teamsList.push({
                    id: i,
                    name: config.name,
                    progress: globalGameState.teamsProgress[i] || 0,
                    lastUpdated: globalGameState.teamsLastUpdated?.[i] || 0,
                    keywords: config.keywords.slice(0, globalGameState.teamsProgress[i] || 0)
                });
            }
            
            // Sắp xếp: Ưu tiên tiến độ cao (giảm dần). Nếu tiến độ bằng nhau, ưu tiên thời gian hoàn thành sớm hơn (tăng dần timestamp)
            teamsList.sort((a, b) => {
                if (b.progress !== a.progress) return b.progress - a.progress;
                return a.lastUpdated - b.lastUpdated; 
            });

            const container = document.getElementById('leaderboard-list');
            container.innerHTML = '';
            
            teamsList.forEach((team, index) => {
                let rankIcon = `<span class="text-2xl font-black text-gray-500 w-8 inline-block text-center">${index + 1}</span>`;
                let bgClass = "bg-white";
                let borderClass = "border-gray-200";
                
                if (index === 0) {
                    rankIcon = `<span class="text-4xl" title="Hạng 1">🥇</span>`;
                    bgClass = "bg-yellow-50";
                    borderClass = "border-yellow-400";
                } else if (index === 1) {
                    rankIcon = `<span class="text-4xl" title="Hạng 2">🥈</span>`;
                    bgClass = "bg-gray-50";
                    borderClass = "border-gray-400";
                } else if (index === 2) {
                    rankIcon = `<span class="text-4xl" title="Hạng 3">🥉</span>`;
                    bgClass = "bg-orange-50";
                    borderClass = "border-orange-400";
                }

                const keywordsHtml = team.keywords.length > 0 
                    ? team.keywords.map(kw => `<span class="inline-block bg-blue-100 text-blue-800 text-xs md:text-sm px-2 py-1 rounded font-bold border border-blue-200">${kw}</span>`).join(' ')
                    : '<span class="text-gray-400 text-xs md:text-sm italic">Chưa có từ khóa</span>';

                container.innerHTML += `
                    <div class="flex items-center gap-3 md:gap-4 p-3 md:p-4 ${bgClass} rounded-2xl border-2 ${borderClass} shadow-sm transition-transform hover:scale-[1.02]">
                        <div class="flex-shrink-0 w-10 md:w-12 text-center flex items-center justify-center">${rankIcon}</div>
                        <div class="flex-1 min-w-0">
                            <h4 class="text-lg md:text-xl font-bold text-gray-800 uppercase whitespace-nowrap overflow-hidden text-ellipsis">${team.name}</h4>
                            <div class="mt-1 flex flex-wrap gap-1 items-center">
                                <span class="text-[10px] md:text-xs font-semibold text-gray-500 mr-1 uppercase">Từ khóa:</span>
                                ${keywordsHtml}
                            </div>
                        </div>
                        <div class="flex-shrink-0 text-center bg-[#1a1e43] text-white px-3 py-1.5 md:px-4 md:py-2 rounded-xl shadow-inner border border-gray-700">
                            <span class="block text-xl md:text-2xl font-black leading-none text-orange-400">${team.progress}</span>
                            <span class="text-[8px] md:text-[10px] uppercase font-bold text-gray-300">Hoàn thành</span>
                        </div>
                    </div>
                `;
            });

            const modal = document.getElementById('leaderboardModal');
            const content = document.getElementById('leaderboardContent');
            modal.classList.remove('hidden');
            setTimeout(() => content.classList.remove('scale-95', 'opacity-0'), 10);
        };

        window.closeLeaderboard = function() {
            const modal = document.getElementById('leaderboardModal');
            const content = document.getElementById('leaderboardContent');
            content.classList.add('scale-95', 'opacity-0');
            setTimeout(() => modal.classList.add('hidden'), 300);
        };

        window.copyStudentLink = function() {
            const url = new URL(window.location.href);
            url.searchParams.set('role', 'student');
            
            const tempInput = document.createElement("input");
            tempInput.style = "position: absolute; left: -1000px; top: -1000px";
            tempInput.value = url.toString();
            document.body.appendChild(tempInput);
            tempInput.select();
            try {
                document.execCommand("copy");
                showToast("Đã copy link dành cho học sinh!", "success");
            } catch (err) {
                showToast("Lỗi khi copy link", "error");
            }
            document.body.removeChild(tempInput);
        };

        // Init on load
        window.onload = () => {
            initGame();
            document.getElementById('passwordInput').addEventListener('keypress', (e) => {
                if (e.key === 'Enter') submitPassword();
            });

            // Kiểm tra tham số URL để tự động vào Trang Học sinh
            const urlParams = new URLSearchParams(window.location.search);
            const role = urlParams.get('role');
            if (role === 'student') {
                switchTab('student');
                // Ẩn thanh tab navigation để học sinh không nhảy sang trang Admin/Giáo viên
                const nav = document.querySelector('nav');
                if(nav) nav.classList.add('hidden');
                document.body.classList.remove('pt-20');
            }
        };
    </script>

