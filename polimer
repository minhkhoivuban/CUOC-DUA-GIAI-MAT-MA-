                <button onclick="closeLeaderboard()" class="bg-gray-800 text-white font-bold py-3 px-10 rounded-xl hover:bg-black transition-colors uppercase tracking-wider text-sm shadow-md">
                    ĐÓNG XẾP HẠNG
                </button>
            </div>
        </div>
    </div>

